# Never commit the real file.
# NewsLiquid (6551 OpenNews) token: the bot's news source and rating. Get it at https://6551.io/mcp
# (WebSocket push needs the Max plan; other paid plans work through REST polling, see README).
OPENNEWS_TOKEN=
# Live mode only.
# API wallet (agent) private key created at https://app.hyperliquid.xyz/API — can sign orders, cannot withdraw.
HL_AGENT_KEY=0x...
# Master account address (the account the agent wallet is approved for)
HL_ACCOUNT=0x...
# Optional: Telegram alerts (Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
